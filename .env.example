# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure either GEMINI_API_KEY or VITE_GEMINI_API_KEY in Vercel Project Environment Variables.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SERPER_API_KEY / VITE_SERPER_API_KEY: Optional for Google site:lex.uz search grounding via Serper.dev.
VITE_SERPER_API_KEY="MY_SERPER_API_KEY"
SERPER_API_KEY="MY_SERPER_API_KEY"

# Supabase (@supabase/supabase-js) — required for cross-device users (app_users) and chats (chat_history)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server-side Supabase overrides
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional primary admin override (defaults to Prolex@admin / 00081187 when omitted)
ADMIN_LOGIN=
ADMIN_PASSWORD=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
