# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for direct Gemini AI API calls.
# Configure either VITE_GEMINI_API_KEY or GEMINI_API_KEY in Vercel Project Environment Variables or AI Studio Settings > Secrets.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SERPER_API_KEY / VITE_SERPER_API_KEY: Optional for Google site:lex.uz search grounding via Serper.dev.
# If omitted or blocked by CORS, Gemini still generates full legal answers safely.
VITE_SERPER_API_KEY="MY_SERPER_API_KEY"
SERPER_API_KEY="MY_SERPER_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
