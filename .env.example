# GEMINI_API_KEY: Required for Gemini AI API calls in /api/chat.
# Configure this in AI Studio Settings > Secrets or Vercel Project Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SERPER_API_KEY: Required for live Google site:lex.uz search grounding via Serper.dev in /api/chat.
# Configure this in AI Studio Settings > Secrets or Vercel Project Environment Variables.
SERPER_API_KEY="MY_SERPER_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
